# Local fallback. Docker Compose uses PostgreSQL instead.
ARGUS_DATABASE_URL=sqlite:///./argus.db
ARGUS_ARTIFACT_DIR=ml/artifacts
ARGUS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ARGUS_OLLAMA_ENABLED=false
ARGUS_OLLAMA_URL=http://127.0.0.1:11434
ARGUS_OLLAMA_MODEL=llama3.2
# Set a private password before starting Compose.
POSTGRES_PASSWORD=argus_local_development
